# Configuração dos agentes usados por scripts/construir.sh.
# Ajuste estes valores depois de conferir `claude --help` e `agy --help`.

# --- Claude Code (implementa) ---
CLAUDE_BIN="claude"
# Modo autônomo: sem pedir permissão a cada comando. Só rode dentro deste repositório;
# o git é a sua rede de segurança (tudo fica em branch e é revertível).
CLAUDE_FLAGS="--dangerously-skip-permissions --output-format json"

# Modelo por módulo. Opus só onde a arquitetura pesa; o resto vai com Sonnet.
MODELO_PADRAO="sonnet"
MODELO_M0="opus"
MODELO_M3="opus"
MODELO_CORRECAO="sonnet"

# --- Revisor ---
# "agy" usa o Antigravity (cota do Google). "claude" usa o Claude com o modelo
# abaixo (gasta a cota da Anthropic). "nenhum" pula a revisão.
REVISOR="agy"
MODELO_REVISOR_CLAUDE="sonnet"

# Comando NÃO interativo do Antigravity. O texto do prompt é acrescentado no final.
# Preencha depois de conferir em `agy --help` (o M0 faz isso e anota aqui).
# Exemplo hipotético: AGY_CMD="agy run --yes --prompt"
AGY_CMD=""

# --- Build ---
TESTE_CMD="mvn -q test"
